# Comma-separated TomTom keys for the live traffic overlay. TomTom tiles carry
# the key per request, so on a tile error (quota/rate-limit/auth) the overlay
# hot-swaps to the next key mid-session. A failed key is remembered (browser
# localStorage) and deprioritized for ~6h so later sessions start from a healthy
# key; traffic is only marked unavailable once every key is exhausted.
# Restrict every browser-visible key by the deployed domain.
VITE_TOMTOM_API_KEYS=first-tomtom-key,second-tomtom-key
# A single VITE_TOMTOM_API_KEY remains supported for existing deployments.
VITE_TOMTOM_TRAFFIC_ENABLED=false

# The client IDs must match the corresponding backend/.env values.
VITE_GOOGLE_CLIENT_ID=your-google-web-client-id
VITE_MICROSOFT_CLIENT_ID=your-microsoft-application-client-id

# Read-only Cesium ion token enables global OSM 3D Buildings on 3D MAP and 3D GLOBE.
VITE_CESIUM_ION_TOKEN=your-cesium-ion-read-token

# Set true only for the explicit demo dataset.
VITE_DEMO_MODE=false
