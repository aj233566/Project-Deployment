# Copy this file to .env and fill in your own values. Never commit or share the real .env.
# MONGO_URI: your MongoDB Atlas connection string. JWT_SECRET: a long random string (at least 32 characters).

RPORT=
MONGO_URI=
JWT_SECRET=
FIRMS_MAP_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=
GNEWS_API_KEY=
GNEWS_LANGUAGE=
GNEWS_COUNTRY=
GNEWS_MAX_ARTICLES=
GOOGLE_CLIENT_ID=
MICROSOFT_CLIENT_ID=

# Long random secret used to sign nearby-network alerts. Set it on the server; without it a new key is made at every start.
MESH_SIGNING_KEY=

# Phone push through Firebase (optional; without it the app keeps its own alert connection open). The Firebase service-account JSON text, or the same text in base64. Never put it in git or in a zip.
FIREBASE_SERVICE_ACCOUNT=

# Optional: Open-Meteo paid key. The free host limits a hosted server's shared address (error 429); the server also keeps the last good answer.
OPEN_METEO_API_KEY=

# Gmail OAuth2 SMTP credentials for OTP email. Keep these only in backend/.env or server secrets.
GMAIL_OAUTH_USER=
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=
